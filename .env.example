# =============================================================================
# Idea Inbox — environment template
# Copy to `.env` and fill in the blanks. Never commit `.env`.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Supabase -> Project Settings -> Database -> "Transaction pooler" (port 6543).
DATABASE_URL=

# --- Machine ingress tokens ---------------------------------------------------
# Generate with: openssl rand -hex 32
# INGEST_TOKEN: Apple Shortcut + in-app capture (POST /api/ideas)
# WORKER_TOKEN: nightly enrichment worker (POST /api/process) and job controls
INGEST_TOKEN=
WORKER_TOKEN=

# --- Dashboard session --------------------------------------------------------
# SESSION_SECRET: openssl rand -hex 32
# DASHBOARD_PASSPHRASE: anything you can type on a phone keyboard
SESSION_SECRET=
DASHBOARD_PASSPHRASE=

# --- LLM + research -----------------------------------------------------------
# DeepSeek API key (https://platform.deepseek.com). Required for enrichment.
DEEPSEEK_API_KEY=
# Tavily API key, used from Phase 4 for standalone research.
TAVILY_API_KEY=

# --- Processing ---------------------------------------------------------------
# Kill switch: "false" makes /api/process a no-op.
PROCESSING_ENABLED=true
# Auto-link an idea only when the model is at least this confident (0..1).
LINK_CONFIDENCE_THRESHOLD=0.7
# Max ideas processed per run. Enforced by the API and by the nightly workflow.
MAX_IDEAS_PER_RUN=25
# Optional model overrides (defaults: deepseek-flash).
DEEPSEEK_ROUTING_MODEL=deepseek-flash
DEEPSEEK_ANALYSIS_MODEL=deepseek-flash
