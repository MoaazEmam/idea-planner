# =============================================================================
# Idea Inbox — environment template
# Copy to `.env` and fill in the blanks. Never commit `.env`.
# =============================================================================

# --- Database -----------------------------------------------------------------
# Supabase -> Project Settings -> Database -> "Transaction pooler" (port 6543).
DATABASE_URL=

# --- App URL ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Machine ingress tokens ---------------------------------------------------
# Generate with: openssl rand -hex 32
# INGEST_TOKEN: Apple Shortcut + in-app capture (POST /api/ideas)
# WORKER_TOKEN: nightly enrichment worker (POST /api/process) and job controls
INGEST_TOKEN=
WORKER_TOKEN=

# --- Dashboard session --------------------------------------------------------
# SESSION_SECRET: openssl rand -hex 32
# DASHBOARD_PASSPHRASE: anything you can type on a phone keyboard
SESSION_SECRET=
DASHBOARD_PASSPHRASE=

# --- LLM + research (wired up in Phase 3+) ------------------------------------
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
